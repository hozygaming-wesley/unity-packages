<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/HierarchyKit/Spawner/Resources/USS/HierarchySpawnerUIToolkit.uss?fileID=7433441132597879392&amp;guid=183516b572a96f9489695786f95e041d&amp;type=3#HierarchySpawnerUIToolkit" />
    <engine:VisualElement name="Container" style="flex-grow: 1; justify-content: flex-start; align-items: stretch; align-self: center; flex-direction: row; flex-wrap: wrap; width: 100%; height: 100%;">
        <engine:ScrollView horizontal-scroller-visibility="Auto" style="flex-grow: 1; width: 100%; height: 100%; overflow: scroll;">
            <engine:VisualElement name="InputFields" style="flex-grow: 1; flex-wrap: wrap; width: 100%; height: auto; align-items: flex-start; flex-direction: row; align-self: flex-start;">
                <engine:TextField label="Prefix" name="Prefix" style="flex-grow: 1; height: 29px; width: auto; text-overflow: clip;" />
                <engine:TextField label="Separator" name="Separator" style="flex-grow: 1; height: 25px; width: auto; align-items: stretch; justify-content: flex-start; align-self: flex-end;" />
                <engine:TextField label="Suffix" name="Suffix" style="flex-grow: 1; height: 25px; width: auto; align-items: stretch; justify-content: flex-start; align-self: flex-end;" />
                <editor:ObjectField label="Prefab" name="PrefabField" style="flex-grow: 1; width: 100%; height: auto;" />
            </engine:VisualElement>
            <engine:VisualElement name="PrefabListContainer" style="flex-grow: 1; flex-direction: column; width: 100%; height: auto;">
                <engine:VisualElement name="PrefabListControls" style="flex-direction: row; justify-content: flex-start; align-items: center; margin-bottom: 5px;">
                    <engine:Button text="+" name="AddPrefabButton" style="width: 30px; height: 30px; margin-right: 5px;" />
                    <engine:Button text="-" name="RemovePrefabButton" style="width: 30px; height: 30px;" />
                </engine:VisualElement>
                <engine:ListView name="PrefabListView" style="flex-grow: 1; width: 100%; height: auto;" />
            </engine:VisualElement>
            <engine:TabView name="ButtonTabView" style="flex-grow: 1; width: 100%; min-width: 300px;">
                <engine:Tab label="Image" name="ImageTab">
                    <engine:VisualElement name="ImageButtons" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-self: flex-start; justify-content: flex-start; align-items: flex-start;">
                        <engine:Button text="Image" name="Image" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="RawImage" name="RawImage" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="Sprite" name="Sprite" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Text" name="TextTab">
                    <engine:VisualElement name="TextButtons" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-self: flex-start; justify-content: flex-start; align-items: flex-start;">
                        <engine:Button text="Legacy_Text" name="Legacy_Text" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="TMP_Text" name="TMP_Text" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Util" name="UtilTab">
                    <engine:VisualElement name="UtilButtons" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-self: flex-start; justify-content: flex-start; align-items: flex-start;">
                        <engine:Button text="Canvas" name="Canvas" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="VSlider" name="VSlider" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="HSlider" name="HSlider" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="VScrollRect" name="VScrollRect" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="ScrollRect" name="HScrollRect" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="Legacy_Button" name="Legacy_Button" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="TMP_Button" name="TMP_Button" enable-rich-text="true" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="VLayout" name="VLayout" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                        <engine:Button text="HLayout" name="HLayout" style="height: auto; padding: 5px; -unity-text-overflow: clip; -unity-text-align: middle-center;" />
                    </engine:VisualElement>
                </engine:Tab>
            </engine:TabView>
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
